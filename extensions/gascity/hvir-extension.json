{
  "id": "hvir.gascity",
  "name": "Gas City",
  "version": "0.5.0",
  "contract": "1.0",
  "requiredCapabilities": [
    "presentation.read",
    "context.read",
    "viewer.open-own",
    "connector.status",
    "connector.execute",
    "connector.output",
    "contributions.publish"
  ],
  "optionalCapabilities": ["connector.connect"],
  "access": [],
  "views": [
    {
      "id": "city",
      "title": "City",
      "entry": "city.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "projects",
      "title": "Gas City",
      "entry": "projects.html",
      "placement": "workspace",
      "navigation": "left",
      "navigationIcon": "city-icon.svg",
      "representations": ["view"]
    },
    {
      "id": "project",
      "title": "Projects",
      "entry": "project.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "session",
      "title": "Gas City session",
      "entry": "session.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "activity",
      "title": "City activity",
      "entry": "activity.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "bead",
      "title": "Bead",
      "entry": "detail.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "pull",
      "title": "Pull request",
      "entry": "pull.html",
      "placement": "workspace",
      "representations": ["view"]
    }
  ],
  "railItems": [
    {
      "id": "city",
      "placement": "header",
      "icon": "⛭",
      "tooltip": "Gas City sessions",
      "kind": "observation",
      "click": {
        "view": "city",
        "placement": "viewer"
      }
    }
  ],
  "connectors": [
    {
      "id": "gc",
      "description": "Read city status, sessions, orders, formulas and events from the Gas City (gc) CLI.",
      "context": "workspace",
      "setup": {
        "executable": "gc"
      },
      "timeoutMs": 60000,
      "outputBytes": 4194304,
      "environment": ["GC_CITY", "PATH"]
    },
    {
      "id": "bd",
      "description": "Read issues from the beads (bd) CLI in the workspace. Passes --readonly, except on stores that refuse it (dolt proxied-server mode), where only list, ready and show run.",
      "context": "workspace",
      "setup": {
        "executable": "bd"
      },
      "timeoutMs": 30000,
      "outputBytes": 4194304,
      "environment": ["BEADS_DOLT_SERVER_PORT", "BEADS_DIR", "PATH"]
    },
    {
      "id": "city-outcomes",
      "description": "Read the city's asks-and-outcomes entries that name a project. city-projects-outcomes accepts only --json and --project, reads one file and runs no other program.",
      "context": "workspace",
      "setup": {
        "executable": "city-projects-outcomes"
      },
      "timeoutMs": 15000,
      "outputBytes": 1048576,
      "environment": ["GC_CITY"]
    },
    {
      "id": "city-pr",
      "description": "Read one pull request and the city's review record for it. city-pr-view accepts only --repo, --number and --json, and runs only gh pr view and a read-only bead list.",
      "context": "workspace",
      "setup": {
        "executable": "city-pr-view"
      },
      "timeoutMs": 60000,
      "outputBytes": 1048576,
      "environment": ["GC_CITY", "GH_HOST", "GH_CONFIG_DIR", "PATH"]
    }
  ]
}

{
  "id": "hvir.gascity",
  "name": "Gas City",
  "version": "0.5.0",
  "contract": "1.0",
  "requiredCapabilities": [
    "presentation.read",
    "context.read",
    "viewer.open-own",
    "connector.status",
    "connector.execute",
    "connector.output",
    "contributions.publish"
  ],
  "optionalCapabilities": [
    "connector.connect",
    "actions.invoke",
    "terminal.start",
    "viewer.open-external"
  ],
  "access": [],
  "views": [
    {
      "id": "city",
      "title": "City",
      "entry": "city.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "projects",
      "title": "Gas City",
      "entry": "projects.html",
      "placement": "workspace",
      "navigation": "left",
      "navigationIcon": "city-icon.svg",
      "representations": ["view"]
    },
    {
      "id": "project",
      "title": "Projects",
      "entry": "project.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "session",
      "title": "Gas City session",
      "entry": "session.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "activity",
      "title": "City activity",
      "entry": "activity.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "bead",
      "title": "Bead",
      "entry": "detail.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "pull",
      "title": "Pull request",
      "entry": "pr/pull.html",
      "placement": "workspace",
      "representations": ["view"]
    },
    {
      "id": "pr-actions",
      "title": "Pull request actions",
      "entry": "pr/pulls.html",
      "placement": "workspace",
      "representations": ["view"]
    }
  ],
  "railItems": [
    {
      "id": "city",
      "placement": "header",
      "icon": "⛭",
      "tooltip": "Gas City sessions",
      "kind": "observation",
      "click": {
        "view": "city",
        "placement": "viewer"
      }
    }
  ],
  "connectors": [
    {
      "id": "gc",
      "description": "Read city status, sessions, orders, formulas and events from the Gas City (gc) CLI.",
      "context": "workspace",
      "setup": {
        "executable": "gc"
      },
      "timeoutMs": 60000,
      "outputBytes": 4194304,
      "environment": ["GC_CITY", "PATH"]
    },
    {
      "id": "bd",
      "description": "Read issues from the beads (bd) CLI in the workspace. Passes --readonly, except on stores that refuse it (dolt proxied-server mode), where only list, ready and show run.",
      "context": "workspace",
      "setup": {
        "executable": "bd"
      },
      "timeoutMs": 30000,
      "outputBytes": 4194304,
      "environment": ["BEADS_DOLT_SERVER_PORT", "BEADS_DIR", "PATH"]
    },
    {
      "id": "city-outcomes",
      "description": "Read the city's asks-and-outcomes entries that name a project. city-projects-outcomes accepts only --json and --project, reads one file and runs no other program.",
      "context": "workspace",
      "setup": {
        "executable": "city-projects-outcomes"
      },
      "timeoutMs": 15000,
      "outputBytes": 1048576,
      "environment": ["GC_CITY"]
    },
    {
      "id": "gh",
      "description": "Read pull requests, diffs, reviews, checks and your assigned issues with the GitHub CLI (gh). The one write: submitting your review and its line comments, only when you click Submit review.",
      "context": "workspace",
      "setup": {
        "executable": "gh"
      },
      "timeoutMs": 30000,
      "outputBytes": 4194304,
      "environment": ["GH_HOST", "GH_CONFIG_DIR"]
    },
    {
      "id": "git",
      "description": "Read the current branch and remotes of the workspace checkout so This branch can list its pull request.",
      "context": "workspace",
      "timeoutMs": 10000,
      "outputBytes": 65536,
      "environment": []
    },
    {
      "id": "shell",
      "description": "Runs sh to open a terminal in a worktree, creating <repo>.hvir-worktrees/pr-N for a pull request first (after you confirm); keep review progress under ~/.hvir/pulls; find the city store and read city review packages.",
      "context": "workspace",
      "timeoutMs": 10000,
      "outputBytes": 4194304,
      "environment": []
    }
  ],
  "actions": [
    {
      "id": "checkout-terminal",
      "title": "Check out a pull request in a new terminal",
      "view": "pr-actions",
      "agents": false,
      "effects": {
        "delete": false,
        "replace": false
      },
      "timeoutMs": 120000,
      "description": "Runs gh pr checkout <number> -R <repo> once in a new terminal at the workspace root, after you confirm in hvir. Works on the workspace's host, local or SSH, with gh approved for that host.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "maxLength": 200
          },
          "number": {
            "type": "number"
          }
        },
        "required": ["repo", "number"],
        "additionalProperties": false
      }
    },
    {
      "id": "worktree-terminal",
      "title": "Open a terminal in a worktree of this repository",
      "view": "pr-actions",
      "agents": false,
      "effects": {
        "delete": false,
        "replace": false
      },
      "timeoutMs": 120000,
      "description": "Opens a new terminal in another worktree of this repository, after you confirm in hvir. The path must be listed by git worktree list on the workspace's host.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "id": "pull-worktree-terminal",
      "title": "Open a pull request's branch in a new worktree",
      "view": "pr-actions",
      "agents": false,
      "effects": {
        "delete": false,
        "replace": false
      },
      "timeoutMs": 120000,
      "description": "Creates <repo>.hvir-worktrees/pr-<number> beside the workspace on the pull request's branch (git fetch, then git worktree add), or reuses it, and opens a terminal there after you confirm in hvir. Same-repository pull requests only.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "number": {
            "type": "number"
          },
          "branch": {
            "type": "string",
            "maxLength": 255
          }
        },
        "required": ["number", "branch"],
        "additionalProperties": false
      }
    }
  ]
}
